TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu

TARGET_DIR = @TARGET_DIR@
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/librsfgseaR.a
PKG_LIBS = -L$(LIBDIR) -lrsfgseaR -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)
	@if [ -n "$(STRIP_SHARED_LIB)" ]; then \
		$(STRIP_SHARED_LIB) $(SHLIB); \
	fi

$(STATLIB):
	mkdir -p $(TARGET_DIR)/libgcc_mock
	touch $(TARGET_DIR)/libgcc_mock/libgcc_eh.a

	TMP_CARGO_HOME=$$(mktemp -d) && \
	trap 'rm -rf "$$TMP_CARGO_HOME"' EXIT INT TERM && \
	if [ -f ./rust/vendor.tar.xz ]; then \
		tar xf rust/vendor.tar.xz -C "$$TMP_CARGO_HOME" && \
		VENDOR_ABS=$$(cygpath -m "$$TMP_CARGO_HOME") && \
		printf '%s\n' '[source.crates-io]' 'replace-with = "vendored-sources"' '' '[source.vendored-sources]' "directory = \"$$VENDOR_ABS\"" > "$$TMP_CARGO_HOME/config.toml"; \
	fi && \
	export CARGO_HOME="$$TMP_CARGO_HOME" && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CURDIR)/$(TARGET_DIR)/libgcc_mock" && \
	RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build @CRAN_FLAGS@ @CARGO_FEATURES@ --locked --target=$(TARGET) --lib @PROFILE@ --manifest-path=rust/Cargo.toml --target-dir=$(TARGET_DIR)

rust_clean: $(SHLIB)
	rm -Rf @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR)
