TARGET_DIR = @TARGET_DIR@
LIBDIR = $(TARGET_DIR)/@LIBDIR@
STATLIB = $(LIBDIR)/librsfgseaR.a
PKG_LIBS = -L$(LIBDIR) -lrsfgseaR

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)
	@if [ -n "$(STRIP_SHARED_LIB)" ]; then \
		$(STRIP_SHARED_LIB) $(SHLIB); \
	fi

# RUSTFLAGS appends --print=native-static-libs to ensure that 
# the correct linkers are used. Use this for debugging if need. 
#
# CRAN note: Cargo and Rustc versions are reported during
# configure via tools/msrv.R.
#
# vendor.tar.xz, if present, is unzipped and used for offline compilation.
$(STATLIB):
	TMP_CARGO_HOME=$$(mktemp -d) && \
	trap 'rm -rf "$$TMP_CARGO_HOME"' EXIT INT TERM && \
	if [ -f ./rust/vendor.tar.xz ]; then \
		tar xf rust/vendor.tar.xz -C "$$TMP_CARGO_HOME" && \
		printf '%s\n' '[source.crates-io]' 'replace-with = "vendored-sources"' '' '[source.vendored-sources]' "directory = \"$$TMP_CARGO_HOME\"" > "$$TMP_CARGO_HOME/config.toml"; \
	fi && \
	export CARGO_HOME="$$TMP_CARGO_HOME" && \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	@PANIC_EXPORTS@RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build @CRAN_FLAGS@ @CARGO_FEATURES@ --locked --lib @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR) @TARGET@

rust_clean: $(SHLIB)
	rm -Rf @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR)
